# OurTextScores environment configuration — copy to .env and fill in real values.
# .env is gitignored; this example is committed. Do NOT put real secrets here.

# ─────────────────────────────────────────────────────────────────────────────
# Auth (NextAuth)
# ─────────────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=            # required: `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3000
AUTH_ALLOW_EMAIL_ACCOUNT_LINKING=false
AUTH_BOOTSTRAP_ADMIN_EMAILS=   # comma-separated admin emails granted on first sign-in
AUTH_BOOTSTRAP_EMAILS=         # comma-separated allowlisted emails
BETA_PREVIEW_ADMIN_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Public URLs
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=/api
INTERNAL_API_URL=http://backend:4000/api
NEXT_PUBLIC_WEB_BASE_URL=http://localhost:3000
PUBLIC_WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SCORE_EDITOR_URL=http://localhost:3000/score-editor

# ─────────────────────────────────────────────────────────────────────────────
# Scanner pilot (disabled until all flags, allowlist, provider, and budget are set)
# ─────────────────────────────────────────────────────────────────────────────
SCANNER_ENABLED=false
NEXT_PUBLIC_SCANNER_ENABLED=false
SCANNER_BETA_USER_IDS=       # comma-separated Mongo user IDs; use * only for an intentional public beta
# Start the separate worker with: docker compose --profile scanner up -d
SCANNER_PROVIDER_KIND=modal  # fake is CI-only; local uses docker-compose.scanner-local.yml
SCANNER_PROVIDER_URL=
SCANNER_PROVIDER_TOKEN=      # generic bearer token; used by the local CPU provider
SCANNER_MODAL_TOKEN_ID=
SCANNER_MODAL_TOKEN_SECRET=
SCANNER_PROVIDER_BUDGET_EXHAUSTED=false
SCANNER_EXPECTED_HOMR_COMMIT=1ddc6fcc26c4baa746eaffbba7f5e01429063465
SCANNER_EXPECTED_PROVIDER_REVISION=ots-homr-modal-v1
SCANNER_EXPECTED_EXECUTION_PROVIDER=CUDAExecutionProvider
SCANNER_MAX_UPLOAD_BYTES=26214400 # combined size for one PDF or one multi-image selection
SCANNER_MAX_PAGES=20             # PDF pages or selected images per job
SCANNER_MAX_IMAGE_DIMENSION=12000
SCANNER_MAX_IMAGE_PIXELS=80000000
SCANNER_MAX_IMAGE_ASPECT_RATIO=20
SCANNER_MAX_MUSICXML_BYTES=10485760
SCANNER_MAX_MUSICXML_NODES=500000   # parsed-node ceiling for provider MusicXML
SCANNER_MAX_MUSICXML_DEPTH=100      # element-nesting ceiling for provider MusicXML
SCANNER_MAX_ACTIVE_JOBS_PER_USER=2
SCANNER_ROLLING_24H_PAGE_QUOTA=50
SCANNER_MAX_MANUAL_RETRIES=1
# Timeout ladder: the provider must abort before this, and the platform (Modal
# function) timeout must sit above it, or an abandoned page keeps billing GPU
# time after OTS has already classified the call as failed.
#   provider hard timeout 540s  <  600000ms here  <  Modal function timeout 660s
SCANNER_PROVIDER_TIMEOUT_MS=600000
SCANNER_RENDER_TIMEOUT_MS=300000
SCANNER_RENDER_WRAPPER_TIMEOUT_SECONDS=300
SCANNER_WORKER_CPUS=1.0
SCANNER_WORKER_MEMORY_LIMIT=2g
SCANNER_TERMINAL_NOTIFICATIONS_ENABLED=true
SCANNER_SOURCE_RETENTION_DAYS=7
SCANNER_RESULT_RETENTION_DAYS=30
# CPU-only HOMR development provider (`npm run scanner:local:up`); never enable on the VPS.
HOMR_LOCAL_PROVIDER_TOKEN=ots-local-development
HOMR_LOCAL_PORT=8010
HOMR_LOCAL_CPUS=4.0
HOMR_LOCAL_MEMORY_LIMIT=8g
# Same ladder as above: the provider's own timeout stays below the worker's.
HOMR_LOCAL_PROCESS_TIMEOUT_SECONDS=1500
HOMR_LOCAL_REQUEST_TIMEOUT_MS=1860000

# ─────────────────────────────────────────────────────────────────────────────
# Score Editor API integration
# The embedded editor calls /api/score-editor/* which the frontend forwards to
# the score_editor_api service (bound to 127.0.0.1 only).
# ─────────────────────────────────────────────────────────────────────────────
SCORE_EDITOR_API_ORIGIN=http://score_editor_api:3000
NEXT_PUBLIC_SCORE_EDITOR_API_BASE=/api/score-editor
# Shared app token. The frontend music proxy injects this as x-ots-api-token and
# the editor API enforces it (OTS_API_AUTH_TOKEN). REQUIRED whenever a server-side
# HF token is set below, or OMR / NotaGen-space routes return 403/401.
# Generate: `openssl rand -hex 32`. Same value must be set on both services.
SCORE_EDITOR_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Editor API — server-credential hardening flags
#   ALLOW_SERVER_LLM_KEYS: allow the editor API to fall back to its own HF/LLM
#     credentials. When 1, SCORE_EDITOR_API_TOKEN MUST be set.
#   ALLOW_UNAUTHENTICATED_LLM_PROXY: leave 0. The frontend proxies /api/llm/* with
#     the app token injected, so the (publicly reachable) editor API must require
#     it. Only set to 1 if the editor API is on a trusted private network.
# ─────────────────────────────────────────────────────────────────────────────
ALLOW_SERVER_LLM_KEYS=1
ALLOW_UNAUTHENTICATED_LLM_PROXY=0

# Server-side Hugging Face space tokens (leave blank to require user-supplied tokens)
MUSIC_TRANSCODA_SPACE_TOKEN=
MUSIC_NOTAGEN_SPACE_TOKEN=
MUSIC_NOTAGEN_DEFAULT_SPACE_ID=jhlusko/NotaGen-Space

# Production editor API image (used with docker-compose.score-editor-image.yml)
OTS_EDITOR_API_IMAGE=ghcr.io/ourtextscores/ots-web-editor-api
OTS_EDITOR_API_IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────────────────────
# MongoDB
# ─────────────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://ots:change_me@mongo:27017/ourtextscores?authSource=admin
MONGO_INITDB_ROOT_USERNAME=ots
MONGO_INITDB_ROOT_PASSWORD=change_me
MONGO_AUTO_INDEX=true

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (object storage)
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_RAW_BUCKET=raw-scores
MINIO_DERIVATIVES_BUCKET=derivatives
MINIO_AUX_BUCKET=aux

# ─────────────────────────────────────────────────────────────────────────────
# Meilisearch
# ─────────────────────────────────────────────────────────────────────────────
MEILI_HOST=http://meili:7700
MEILI_MASTER_KEY=meili_master_key

# ─────────────────────────────────────────────────────────────────────────────
# Email (NextAuth magic links + notifications)
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_SERVER=smtp://mailpit:1025
EMAIL_FROM=no-reply@ourtextscores.com
LEGAL_CONTACT_EMAIL=
LEGAL_EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────────────────
# Fossil (version control backend for scores)
# ─────────────────────────────────────────────────────────────────────────────
FOSSIL_PATH=/data/fossil_data
FOSSIL_USER=ots

# ─────────────────────────────────────────────────────────────────────────────
# Music tooling (backend + editor API) — defaults are usually fine
# ─────────────────────────────────────────────────────────────────────────────
MUSESCORE_CLI=musescore4
MUSESCORE_PDF_MODE=async
MUSESCORE_EXPORT_TIMEOUT_MS=0
MUSESCORE_WRAPPER_TIMEOUT_SECONDS=0
KERN_CONVERTER_CLI=krn2musicxml
KERN_CONVERTER_TIMEOUT_MS=60000
ABC_CONVERTER_TIMEOUT_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# OpenTelemetry (optional)
# ─────────────────────────────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ourtextscores-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
SCORE_EDITOR_OTEL_ENABLED=false
SCORE_EDITOR_OTEL_SERVICE_NAME=ots-web-score-editor-api
